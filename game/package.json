{
  "name": "death-note-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "publish": "vite build --outDir ../deathnote --emptyOutDir",

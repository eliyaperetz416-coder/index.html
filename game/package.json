    "test": "vitest run",
    "e2e": "node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}

rules_version = '2';

// Shopping list security rules.
//
//   lists/{listId}                  a shared list; only its members can read or edit it
//   lists/{listId}/items/{itemId}   one item on the list (schema version 2); optional quantity, note
//   lists/{listId}/history/{YYYY-MM} purchases of one month (schema version 2)
//   lists/{listId}/templates/{id}   saved list templates (see below)
//   lists/{listId}/joins/{uid}      "I joined with this code" — written by the joiner
//   joinCodes/{code}                code -> listId; can be looked up one at a time, never listed
//
// Version 1 lists kept items and purchase history as arrays on the list document. Any
// member's app copies them into items/history, then sets schemaVersion: 2. From then on
// the old arrays are a read-only backup.
//
// Tested in tests/rules/firestore.test.mjs (npm run test:rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // Old app versions made 6-character codes, new ones make 8. Same alphabet (no 0/O/1/I).
    function validCode(code) {
      return code is string && code.matches('^[A-HJ-NP-Z2-9]{6}([A-HJ-NP-Z2-9]{2})?$');
    }
    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 100;
    }
    function smallList(value) {
      return value is list && value.size() <= 1000;
    }
    function listPath(listId) {
      return /databases/$(database)/documents/lists/$(listId);
    }
    function codePath(code) {
      return /databases/$(database)/documents/joinCodes/$(code);
    }
    function isListMember(listId) {
      return signedIn() && me() in get(listPath(listId)).data.members;
    }
    function optional(data, key, test) {
      return !(key in data) || test;
    }
    function validEntry(e) {
      return e is map
        && e.keys().hasOnly(['itemId', 'name', 'catKey', 'timestamp'])
        && e.name is string && e.name.size() <= 200
        && e.catKey is string && e.catKey.size() <= 20
        && e.timestamp is number;
    }
    function validTemplate(d) {
      return d.keys().hasOnly(['name', 'items', 'createdBy', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.items is list && d.items.size() <= 200
        && d.createdBy is string
        && d.createdAt is number;
    }
    function validItem(d) {
      return d.keys().hasOnly(['name', 'catKey', 'bought', 'boughtAt', 'createdAt', 'createdBy', 'urgency', 'purchase', 'quantity', 'note'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.catKey is string && d.catKey.size() <= 20
        && d.bought is bool
        && (d.boughtAt == null || d.boughtAt is number)
        && d.createdAt is number
        && d.createdBy is string
        && optional(d, 'urgency', d.get('urgency', null) == null || d.get('urgency', null) in ['high', 'medium', 'low'])
        && optional(d, 'purchase', validEntry(d.get('purchase', null)))
        && optional(d, 'quantity', d.get('quantity', '') is string && d.get('quantity', '').size() <= 40)
        && optional(d, 'note', d.get('note', '') is string && d.get('note', '').size() <= 200);
    }

    match /lists/{listId} {
      function isMember() { return signedIn() && me() in resource.data.members; }
      function isOwner() { return signedIn() && resource.data.ownerUid == me(); }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

      // The only change to `members` a member may make: remove themselves (leave).
      // The owner cannot leave their own list.
      function leavesAlone() {
        return !isOwner()
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([me()].toSet())
          && request.resource.data.members.size() == resource.data.members.size() - 1;
      }

      function migrated() { return resource.data.get('schemaVersion', 1) == 2; }

      // Moving to version 2 happens once, together with a migration time. A second,
      // late migration (another member's app at the same moment) is refused as a whole.
      function migrationFlagOk() {
        return !changed().hasAny(['schemaVersion', 'migratedAt'])
          || (changed().hasAll(['schemaVersion', 'migratedAt'])
              && request.resource.data.schemaVersion == 2
              && request.resource.data.migratedAt == request.time
              && !migrated());
      }

      // A member may publish their own display name, and nobody else's.
      function ownNameOnly() {
        let before = resource.data.get('memberNames', {});
        let after = request.resource.data.memberNames;
        return after is map
          && after.diff(before).affectedKeys().hasOnly([me()])
          && after.get(me(), '') is string
          && after.get(me(), '').size() <= 100;
      }

      function memberEdit() {
        return isMember()
          && !changed().hasAny(['ownerUid', 'createdAt'])
          && migrationFlagOk()
          && (!changed().hasAny(['items', 'purchaseHistory']) || !migrated())
          && (!changed().hasAny(['members']) || leavesAlone())
          && (!changed().hasAny(['code']) || (isOwner() && validCode(request.resource.data.code)))
          && (!changed().hasAny(['name']) || validName(request.resource.data.name))
          && (!changed().hasAny(['memberNames']) || ownNameOnly())
          && (!changed().hasAny(['items']) || smallList(request.resource.data.items))
          && (!changed().hasAny(['purchaseHistory']) || smallList(request.resource.data.purchaseHistory));
      }

      // Joining: in the same batch the joiner writes lists/{listId}/joins/{me} with the
      // code they typed, and adds exactly themselves to `members` — nothing else.
      function joinsWithCode() {
        let joinRecord = getAfter(/databases/$(database)/documents/lists/$(listId)/joins/$(me()));
        return signedIn()
          && !(me() in resource.data.members)
          && changed().hasOnly(['members'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([me()].toSet())
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && get(codePath(joinRecord.data.code)).data.listId == listId;
      }

      // `list` (queries) works only for "where members array-contains me".
      allow get, list: if isMember();

      // New lists are version 2 (no arrays); the old app version still creates version 1.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'code', 'ownerUid', 'members', 'items', 'purchaseHistory', 'createdAt', 'schemaVersion'])
        && request.resource.data.ownerUid == me()
        && request.resource.data.members == [me()]
        && validName(request.resource.data.name)
        && validCode(request.resource.data.code)
        && smallList(request.resource.data.get('items', []))
        && smallList(request.resource.data.get('purchaseHistory', []))
        && request.resource.data.get('schemaVersion', 1) in [1, 2];

      allow update: if memberEdit() || joinsWithCode();
      allow delete: if isOwner();

      match /items/{itemId} {
        allow read: if isListMember(listId);
        allow create: if isListMember(listId)
          && itemId.size() <= 64
          && validItem(request.resource.data)
          && request.resource.data.createdBy == me();
        allow update: if isListMember(listId)
          && validItem(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt']);
        allow delete: if isListMember(listId);
      }

      // Saved templates: a named set of items that can be added to the list in one go.
      match /templates/{templateId} {
        allow read: if isListMember(listId);
        allow create: if isListMember(listId)
          && templateId.size() <= 64
          && validTemplate(request.resource.data)
          && request.resource.data.createdBy == me();
        allow update: if isListMember(listId)
          && validTemplate(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isListMember(listId);
      }

      match /history/{month} {
        allow read: if isListMember(listId);
        allow delete: if signedIn() && get(listPath(listId)).data.ownerUid == me(); // when the owner deletes the list
        allow create, update: if isListMember(listId)
          && month.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['entries'])
          && request.resource.data.entries is list
          && request.resource.data.entries.size() <= 5000;
      }

      match /joins/{uid} {
        allow delete: if signedIn() && get(listPath(listId)).data.ownerUid == me(); // when the owner deletes the list
        allow read: if signedIn() && (uid == me() || me() in get(listPath(listId)).data.members);
        allow create, update: if signedIn()
          && uid == me()
          && request.resource.data.keys().hasOnly(['code', 'at'])
          && validCode(request.resource.data.code)
          && request.resource.data.at == request.time
          && get(codePath(request.resource.data.code)).data.listId == listId;
      }
    }

    match /joinCodes/{code} {
      // Looking up a single code you were given is fine; listing all codes is not.
      allow get: if signedIn();
      allow list: if false;

      // Only the list's owner registers its code (also in the same batch that creates the
      // list, hence getAfter). An existing code can never be overwritten (that is an update).
      allow create: if signedIn()
        && validCode(code)
        && request.resource.data.keys().hasOnly(['listId', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && getAfter(listPath(request.resource.data.listId)).data.ownerUid == me()
        && getAfter(listPath(request.resource.data.listId)).data.code == code;
      allow update: if false;
      allow delete: if signedIn() && resource.data.createdBy == me();
    }
  }
}

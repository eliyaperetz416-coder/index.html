rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user reads and writes only their own tree: users/{uid} and everything under it.
    // Sharing with friends later = add explicit rules here; nothing else is open.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
